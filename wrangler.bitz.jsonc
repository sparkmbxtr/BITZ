{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bitz",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "workers_dev": true,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "AIRQ_BACKEND",
      "service": "spark"
    }
  ],
  "observability": {
    "enabled": true
  }
}
