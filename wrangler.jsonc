{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spark",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTEXT_LOG",
        "class_name": "ContextLog"
      }
    ]
  },
  "migrations": [
    {
      "tag": "context-log-v1",
      "new_sqlite_classes": ["ContextLog"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
